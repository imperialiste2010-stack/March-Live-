# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Client-side)
VITE_GOOGLE_MAPS_API_KEY=""

# Yango Delivery API (Optional — falls back to manual merchant courier dispatch when unset)
YANGO_DELIVERY_API_KEY=""

# Mobile Money Provider Webhook Secrets (HMAC SHA-256 verification - optional when API active)
WAVE_WEBHOOK_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET=""
MTN_MOMO_WEBHOOK_SECRET=""
MOOV_MONEY_WEBHOOK_SECRET=""

# Zero-API Mobile Money Reception Numbers / Wave Payment Link (for direct transfer mode)
PLATFORM_WAVE_PHONE=""
PLATFORM_WAVE_LINK=""
PLATFORM_ORANGE_PHONE=""
PLATFORM_MTN_PHONE=""
PLATFORM_MOOV_PHONE=""

# Mobile Packaging (Capacitor Android APK / iOS App)
# Leave empty on Web/PWA; set to your HTTPS backend URL when building native mobile apps.
VITE_API_BASE_URL=""
CORS_ORIGINS=""

# Web Push Notifications (Optional — auto-generated & stored in Cloud SQL when unset)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@marchelive.ci"

# Supabase Realtime (Optional — enables Supabase Realtime delivery tracking channel when set)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
